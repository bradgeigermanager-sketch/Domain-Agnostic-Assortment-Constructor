{
  "domain": "military_operations",
  "version": "2.0.0",
  "scope_note": "A domain ontology and taxonomy mapping joint force operations, command and control (C2), kinetic and non-kinetic fires, intelligence collection, combat logistics, and theater operational art.",
  "subjects": {
    "command_and_control": {
      "description": "Operational authority, battle management, communications architectures, mission command directives, and staff coordination.",
      "topics": [
        "operational_order_dissemination",
        "rules_of_engagement_delegation",
        "joint_force_air_component_control",
        "battlespace_deconfliction",
        "continuity_of_command"
      ]
    },
    "intelligence_surveillance_reconnaissance": {
      "description": "Multi-INT collection, sensor-to-shooter pairing, order-of-battle analysis, and target intelligence preparation.",
      "topics": [
        "signals_intelligence_collection",
        "geospatial_imagery_reconnaissance",
        "electronic_order_of_battle",
        "battle_damage_assessment",
        "target_coordinate_mensuration"
      ]
    },
    "maneuver_and_fires": {
      "description": "Kinetic strike coordination, combined arms maneuver, close air support, air and missile defense, and non-kinetic fires.",
      "topics": [
        "suppression_of_enemy_air_defenses",
        "deep_strike_interdiction",
        "combined_arms_breaching",
        "integrated_air_and_missile_defense",
        "electronic_attack_and_jamming"
      ]
    },
    "operational_logistics": {
      "description": "Sustainment pipelines, munitions replenishment, combat engineering, medical evacuation, and distribution security.",
      "topics": [
        "class_v_ammunition_resupply",
        "forward_arm_and_refuel_point_ops",
        "aeromedical_evacuation",
        "combat_engineer_route_clearance",
        "contested_logistics_distribution"
      ]
    },
    "force_protection_and_cbrn": {
      "description": "Threat mitigation, base defense, counter-unmanned systems, chemical/biological defense, and deception operations.",
      "topics": [
        "counter_uas_engagement",
        "cbrn_reconnaissance_and_decon",
        "perimeter_defense_operations",
        "military_deception_coordination",
        "opsec_vulnerability_mitigation"
      ]
    }
  },
  "slots": {
    "relationship": {
      "slot_id": "relationship",
      "semantic_role": "operational_relation",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["relationship"],
        "domain_scope": ["military_operations", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "entity": {
      "slot_id": "entity",
      "semantic_role": "asset_order_or_operational_element",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["entity"],
        "domain_scope": ["military_operations", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "target": {
      "slot_id": "target",
      "semantic_role": "operational_objective_or_focal_event",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["target"],
        "domain_scope": ["military_operations", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "operational_phase": {
      "slot_id": "operational_phase",
      "semantic_role": "joint_campaign_phase",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["operational_phase"],
        "domain_scope": ["military_operations", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "echelon": {
      "slot_id": "echelon",
      "semantic_role": "command_level",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["echelon"],
        "domain_scope": ["military_operations", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    }
  },
  "templates": [
    {
      "template_id": "mil_interrogative_core",
      "pattern": "What {relationship} {entity:plural} relate to {target} [during {operational_phase}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["operational_phase"]
    },
    {
      "template_id": "mil_echelon_fires_diagnostic",
      "pattern": "Which {entity:plural} execute a {relationship} task against {target} at {echelon:article}?",
      "required_slots": ["relationship", "entity", "target", "echelon"],
      "optional_slots": []
    },
    {
      "template_id": "mil_phased_mission_audit",
      "pattern": "How do {relationship} {entity:plural} coordinated by {echelon:article} support {target} [in {operational_phase}]?",
      "required_slots": ["relationship", "entity", "target", "echelon"],
      "optional_slots": ["operational_phase"]
    },
    {
      "template_id": "mil_effect_synchronization",
      "pattern": "What {relationship} {entity:plural} produce intended effects on {target} under {operational_phase} conditions?",
      "required_slots": ["relationship", "entity", "target", "operational_phase"],
      "optional_slots": []
    }
  ],
