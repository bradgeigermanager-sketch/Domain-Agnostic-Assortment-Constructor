{
  "domain": "military_intelligence",
  "version": "2.0.0",
  "scope_note": "A domain ontology and taxonomy mapping the intelligence cycle, multi-source intelligence disciplines (INTs), collection management, threat modeling, all-source fusion, target development, and counterintelligence.",
  "subjects": {
    "collection_disciplines": {
      "description": "Tasking, collection, and exploitation across technical and human intelligence domains (GEOINT, SIGINT, HUMINT, OSINT, MASINT).",
      "topics": [
        "signals_intelligence_interception",
        "geospatial_imagery_exploitation",
        "human_source_clandestine_collection",
        "open_source_telemetry_harvesting",
        "measurement_and_signature_surveillance"
      ]
    },
    "all_source_analysis_and_fusion": {
      "description": "Integration, evaluation, and synthesis of disparate multi-INT feeds into finished intelligence products.",
      "topics": [
        "threat_actor_attribution",
        "order_of_battle_reconstruction",
        "indication_and_warning_thresholds",
        "structured_analytic_techniques",
        "course_of_action_forecasting"
      ]
    },
    "target_intelligence_and_weaponeering": {
      "description": "Target system analysis, coordinate verification, collateral damage estimation, and joint targeting cycles.",
      "topics": [
        "target_system_analysis",
        "coordinate_mensuration_and_validation",
        "collateral_damage_estimation",
        "high_value_individual_tracking",
        "physical_and_functional_damage_assessment"
      ]
    },
    "counterintelligence_and_security": {
      "description": "Detecting, identifying, exploiting, and neutralizing foreign intelligence entity (FIE) activities and insider threats.",
      "topics": [
        "insider_threat_anomaly_detection",
        "foreign_intelligence_penetration_auditing",
        "deception_detection_and_analysis",
        "counter_surveillance_tradecraft",
        "sensitive_compartmented_security_audits"
      ]
    },
    "collection_management_and_dissemination": {
      "description": "Requirements prioritization, collection deck scheduling, sensor-to-analyst routing, and dissemination protocols.",
      "topics": [
        "priority_intelligence_requirements_tracking",
        "sensor_allocation_and_tasking",
        "multi_agency_federated_sharing",
        "tearline_sanitization_and_declassification",
        "collection_posture_gap_analysis"
      ]
    }
  },
  "slots": {
    "relationship": {
      "slot_id": "relationship",
      "semantic_role": "analytic_or_collection_relation",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["relationship"],
        "domain_scope": ["military_intelligence", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "entity": {
      "slot_id": "entity",
      "semantic_role": "intel_report_sensor_or_artifact",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["entity"],
        "domain_scope": ["military_intelligence", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "target": {
      "slot_id": "target",
      "semantic_role": "focal_intelligence_subject_or_target",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["target"],
        "domain_scope": ["military_intelligence", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "classification_level": {
      "slot_id": "classification_level",
      "semantic_role": "dissemination_and_handling_caveat",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["classification_level"],
        "domain_scope": ["military_intelligence", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "analytic_confidence": {
      "slot_id": "analytic_confidence",
      "semantic_role": "evaluative_confidence_level",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["analytic_confidence"],
        "domain_scope": ["military_intelligence", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    }
  },
  "templates": [
    {
      "template_id": "mi_interrogative_core",
      "pattern": "What {relationship} {entity:plural} relate to {target} [at {classification_level}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["classification_level"]
    },
    {
      "template_id": "mi_confidence_diagnostic",
      "pattern": "Which {entity:plural} provide {analytic_confidence} confidence in a {relationship} nexus with {target}?",
      "required_slots": ["relationship", "entity", "target", "analytic_confidence"],
      "optional_slots": []
    },
    {
      "template_id": "mi_analytic_synthesis",
      "pattern": "How do {relationship} {entity:plural} evaluate {target} under {classification_level} dissemination caveats?",
      "required_slots": ["relationship", "entity", "target", "classification_level"],
      "optional_slots": []
    },
    {
      "template_id": "mi_collection_correlation",
      "pattern": "What {relationship} {entity:plural} corroborate {target} [with {analytic_confidence} confidence]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["analytic_confidence"]
    }
  ],
