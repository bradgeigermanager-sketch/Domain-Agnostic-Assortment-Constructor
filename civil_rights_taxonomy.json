{
  "domain": "civil_rights",
  "version": "2.0.0",
  "scope_note": "A domain ontology and taxonomy mapping constitutional deprivations, statutory civil rights enforcement, state-action doctrine, systemic institutional discrimination, equal protection scrutiny, remedial injunctions, and federal oversight under U.S. Code Titles 18 and 42.",
  "subjects": {
    "constitutional_deprivations_and_state_action": {
      "description": "Deprivations of constitutional rights under color of law, police misconduct, Fourth and Fourteenth Amendment violations, and qualified immunity inquiries.",
      "topics": [
        "color_of_law_nexus",
        "excessive_force_and_seizure",
        "due_process_deprivations",
        "qualified_immunity_overcoming",
        "deliberate_indifference_in_custody"
      ]
    },
    "equal_protection_and_antidiscrimination": {
      "description": "Disparate treatment, disparate impact, systemic exclusion, and discrimination across employment, housing, education, and public accommodations.",
      "topics": [
        "disparate_impact_analysis",
        "disparate_treatment_proof",
        "protected_class_burden_shifting",
        "reasonable_accommodation_denials",
        "retaliation_and_whistleblower_interference"
      ]
    },
    "voting_rights_and_electoral_access": {
      "description": "Access to the franchise, vote dilution, redistricting challenges, language minority accommodations, and voting administration barriers.",
      "topics": [
        "vote_dilution_and_gerrymandering",
        "voter_suppression_and_purging",
        "preclearance_and_special_coverage",
        "accessibility_barrier_identification",
        "election_worker_intimidation"
      ]
    },
    "institutional_reform_and_consent_decrees": {
      "description": "Pattern-or-practice investigations, systemic injunctive relief, court-appointed monitoring teams, and municipal compliance mandates.",
      "topics": [
        "pattern_or_practice_investigation",
        "independent_monitoring_audits",
        "consent_decree_compliance",
        "policy_reform_and_training_remediation",
        "injunctive_oversight_termination"
      ]
    },
    "statutory_remedies_and_liability": {
      "description": "Civil liability frameworks under Section 1983, Monell municipal liability, statutory fee-shifting, and criminal civil rights prosecutions.",
      "topics": [
        "monell_custom_or_policy_attribution",
        "supervisory_liability_frameworks",
        "section_241_and_242_criminal_prosecution",
        "attorneys_fees_and_remedies",
        "declaratory_and_preliminary_relief"
      ]
    }
  },
  "slots": {
    "relationship": {
      "slot_id": "relationship",
      "semantic_role": "civil_rights_action_or_violation_relation",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["relationship"],
        "domain_scope": ["civil_rights", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "entity": {
      "slot_id": "entity",
      "semantic_role": "deprivation_evidence_or_remedial_instrument",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["entity"],
        "domain_scope": ["civil_rights", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "target": {
      "slot_id": "target",
      "semantic_role": "civil_rights_harm_statute_or_institution",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["target"],
        "domain_scope": ["civil_rights", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "scrutiny_standard": {
      "slot_id": "scrutiny_standard",
      "semantic_role": "equal_protection_or_constitutional_tier",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["scrutiny_standard"],
        "domain_scope": ["civil_rights", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "statutory_basis": {
      "slot_id": "statutory_basis",
      "semantic_role": "enabling_statute_or_amendment",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["statutory_basis"],
        "domain_scope": ["civil_rights", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    }
  },
  "templates": [
    {
      "template_id": "cr_interrogative_core",
      "pattern": "What {relationship} {entity:plural} relate to {target} [under {statutory_basis}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["statutory_basis"]
    },
    {
      "template_id": "cr_scrutiny_diagnostic",
      "pattern": "Which {entity:plural} establish a {relationship} practice regarding {target} subject to {scrutiny_standard}?",
      "required_slots": ["relationship", "entity", "target", "scrutiny_standard"],
      "optional_slots": []
    },
    {
      "template_id": "cr_remedial_compliance_audit",
      "pattern": "How do {relationship} {entity:plural} redress {target} within the scope of {statutory_basis}?",
      "required_slots": ["relationship", "entity", "target", "statutory_basis"],
      "optional_slots": []
    },
    {
      "template_id": "cr_constitutional_liability_evaluation",
      "pattern": "What {relationship} {entity:plural} substantiate liability for {target} [evaluated under {scrutiny_standard}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["scrutiny_standard"]
    }
  ],
