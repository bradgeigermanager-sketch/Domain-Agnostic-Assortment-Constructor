  "constraints": [
    {
      "type": "domain_alignment"
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "mil_rel_directing"
      },
      "then": {
        "slot": "entity",
        "values": [
          "mil_ent_air_tasking_order"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "mil_rel_jamming"
      },
      "then": {
        "slot": "entity",
        "values": [
          "mil_ent_ew_pod"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "mil_rel_resupplying"
      },
      "then": {
        "slot": "entity",
        "values": [
          "mil_ent_farp"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "mil_rel_jamming"
      },
      "then": {
        "slot": "target",
        "values": [
          "mil_tgt_integrated_air_defense",
          "mil_tgt_radar_emitter"
        ]
      }
    },
    {
      "type": "excludes",
