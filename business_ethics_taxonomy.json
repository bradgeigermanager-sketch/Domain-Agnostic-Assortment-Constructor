{
  "domain": "business_ethics",
  "version": "2.0.0",
  "scope_note": "A domain ontology and taxonomy mapping corporate governance, fiduciary duties, regulatory compliance, anti-bribery/anti-corruption, conflict-of-interest mitigation, environmental and social governance (ESG), whistleblower reporting, and executive accountability.",
  "subjects": {
    "corporate_governance_and_fiduciary_duties": {
      "description": "Board oversight, duties of care and loyalty, shareholder rights, executive compensation governance, and Caremark oversight standards.",
      "topics": [
        "duty_of_loyalty_and_care",
        "board_oversight_and_caremark_claims",
        "related_party_transactions",
        "executive_compensation_clawbacks",
        "shareholder_derivative_actions"
      ]
    },
    "anticorruption_and_trade_integrity": {
      "description": "Foreign Corrupt Practices Act (FCPA) compliance, bribery prohibition, anti-money laundering (AML), export controls, and sanction screenings.",
      "topics": [
        "fcpa_anti_bribery_prohibitions",
        "third_party_intermediary_due_diligence",
        "anti_money_laundering_know_your_customer",
        "trade_sanctions_and_export_controls",
        "facilitation_payment_auditing"
      ]
    },
    "accounting_integrity_and_financial_reporting": {
      "description": "Internal financial controls, revenue recognition auditing, Sarbanes-Oxley (SOX) compliance, and forensic accounting reviews.",
      "topics": [
        "sox_internal_control_assessments",
        "revenue_recognition_fraud_detection",
        "off_balance_sheet_transaction_scrutiny",
        "independent_audit_committee_oversight",
        "financial_restatements_and_disclosures"
      ]
    },
    "workplace_ethics_and_whistleblower_systems": {
      "description": "Code of conduct enforcement, hotline intake, retaliation prevention, harassment investigations, and labor standard auditing.",
      "topics": [
        "whistleblower_hotline_intake_and_triage",
        "anti_retaliation_monitoring_and_remedies",
        "code_of_conduct_violation_investigation",
        "diversity_equity_and_fair_labor_audits",
        "confidential_internal_grievance_mechanisms"
      ]
    },
    "environmental_social_governance_and_supply_chain": {
      "description": "Sustainability claims verification, human rights due diligence in vendor pipelines, climate disclosures, and consumer product transparency.",
      "topics": [
        "greenwashing_and_esg_metrics_verification",
        "supply_chain_human_rights_due_diligence",
        "scope_1_2_3_carbon_accounting_audits",
        "conflict_minerals_and_raw_material_lineage",
        "product_safety_and_consumer_transparency"
      ]
    }
  },
  "slots": {
    "relationship": {
      "slot_id": "relationship",
      "semantic_role": "ethical_governance_or_compliance_relation",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["relationship"],
        "domain_scope": ["business_ethics", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "entity": {
      "slot_id": "entity",
      "semantic_role": "compliance_record_audit_instrument_or_action",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["entity"],
        "domain_scope": ["business_ethics", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "target": {
      "slot_id": "target",
      "semantic_role": "ethical_risk_entity_transaction_or_violation",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["target"],
        "domain_scope": ["business_ethics", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "regulatory_framework": {
      "slot_id": "regulatory_framework",
      "semantic_role": "governing_statute_standard_or_code",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["regulatory_framework"],
        "domain_scope": ["business_ethics", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "governance_body": {
      "slot_id": "governance_body",
      "semantic_role": "oversight_authority_or_committee",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["governance_body"],
        "domain_scope": ["business_ethics", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    }
  },
  "templates": [
    {
      "template_id": "eth_interrogative_core",
      "pattern": "What {relationship} {entity:plural} relate to {target} [pursuant to {regulatory_framework}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["regulatory_framework"]
    },
    {
      "template_id": "eth_oversight_diagnostic",
      "pattern": "Which {entity:plural} supervised by {governance_body:article} demonstrate a {relationship} nexus with {target}?",
      "required_slots": ["relationship", "entity", "target", "governance_body"],
      "optional_slots": []
    },
    {
      "template_id": "eth_compliance_audit_inquiry",
      "pattern": "How do {relationship} {entity:plural} evaluate compliance of {target} under {regulatory_framework}?",
      "required_slots": ["relationship", "entity", "target", "regulatory_framework"],
      "optional_slots": []
    },
    {
      "template_id": "eth_fiduciary_review",
      "pattern": "What {relationship} {entity:plural} substantiated by {governance_body:article} address {target} [under {regulatory_framework}]?",
      "required_slots": ["relationship", "entity", "target", "governance_body"],
      "optional_slots": ["regulatory_framework"]
    }
  ],
