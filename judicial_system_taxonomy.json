  "constraints": [
    {
      "type": "domain_alignment"
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "jud_rel_filing"
      },
      "then": {
        "slot": "entity",
        "values": [
          "jud_ent_pleading",
          "jud_ent_motion",
          "jud_ent_appellate_brief"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "jud_rel_ruling"
      },
      "then": {
        "slot": "entity",
        "values": [
          "jud_ent_ruling_order"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "jud_rel_sealing"
      },
      "then": {
        "slot": "entity",
        "values": [
          "jud_ent_sealed_record",
          "jud_ent_deposition_transcript"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "jud_rel_appealing"
      },
      "then": {
        "slot": "target",
        "values": [
          "jud_tgt_appellate_mandate"
        ]
      }
    },
    {
      "type": "excludes",
      "if": {
        "slot": "relationship",
        "value": "jud_rel_sanctioning"
      },
      "then": {
        "slot": "entity",
        "values": [
          "jud_ent_deposition_transcript",
          "jud_ent_interrogatory"
        ]
      }
    }
  ]
