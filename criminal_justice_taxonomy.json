{
  "domain": "criminal_justice",
  "version": "2.0.0",
  "scope_note": "A domain ontology and taxonomy mapping criminal offenses, investigative enforcement, custody and booking, evidentiary forensics, prosecutorial charging, constitutional defenses, and correctional supervision.",
  "subjects": {
    "investigation_and_policing": {
      "description": "Field stops, searches, seizures, surveillance, suspect interrogations, and initial incident reporting.",
      "topics": [
        "traffic_and_terry_stops",
        "search_and_seizure_execution",
        "custodial_interrogation",
        "undercover_surveillance",
        "incident_report_generation"
      ]
    },
    "substantive_criminal_law": {
      "description": "Statutory elements, mens rea classifications, actus reus, inchoate offenses, and affirmative defenses.",
      "topics": [
        "element_satisfaction",
        "mens_rea_attribution",
        "inchoate_conspiracy_and_attempt",
        "affirmative_justifications",
        "felony_enhancements"
      ]
    },
    "custody_and_booking": {
      "description": "Arrest, physical booking, biometric intake, bail determinations, and detention management.",
      "topics": [
        "warrantless_probable_cause_arrest",
        "biometric_and_intake_processing",
        "pretrial_risk_assessment",
        "bail_and_bond_conditions",
        "facility_intake_searches"
      ]
    },
    "forensics_and_chain_of_custody": {
      "description": "Collection, custody logging, laboratory testing, ballistics, toxicology, and digital forensics.",
      "topics": [
        "physical_evidence_logging",
        "chain_of_custody_transfers",
        "laboratory_toxicology_and_dna",
        "ballistics_and_toolmark_matching",
        "digital_device_extractions"
      ]
    },
    "adjudication_and_sentencing": {
      "description": "Grand jury proceedings, indictments, preliminary hearings, plea negotiations, trials, and sentencing.",
      "topics": [
        "grand_jury_indictments",
        "probable_cause_hearings",
        "plea_bargaining_allocutions",
        "evidentiary_suppression_hearings",
        "statutory_sentencing_guidelines"
      ]
    },
    "corrections_and_parole": {
      "description": "Institutional confinement, probationary supervision, community monitoring, and revocation hearings.",
      "topics": [
        "probationary_compliance_auditing",
        "parole_revocation_proceedings",
        "community_supervision_conditions",
        "rehabilitative_mandates",
        "sentence_credit_calculations"
      ]
    }
  },
  "slots": {
    "relationship": {
      "slot_id": "relationship",
      "semantic_role": "criminological_or_enforcement_relation",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["relationship"],
        "domain_scope": ["criminal_justice", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "entity": {
      "slot_id": "entity",
      "semantic_role": "enforcement_action_record_or_instrument",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["entity"],
        "domain_scope": ["criminal_justice", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "target": {
      "slot_id": "target",
      "semantic_role": "offense_anchor_or_subject",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["target"],
        "domain_scope": ["criminal_justice", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "procedural_stage": {
      "slot_id": "procedural_stage",
      "semantic_role": "criminal_justice_timeline_stage",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["procedural_stage"],
        "domain_scope": ["criminal_justice", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "evidentiary_threshold": {
      "slot_id": "evidentiary_threshold",
      "semantic_role": "burden_or_quantum_of_proof",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["evidentiary_threshold"],
        "domain_scope": ["criminal_justice", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    }
  },
  "templates": [
    {
      "template_id": "cj_interrogative_core",
      "pattern": "What {relationship} {entity:plural} relate to {target} [during {procedural_stage}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["procedural_stage"]
    },
    {
      "template_id": "cj_enforcement_threshold_diagnostic",
      "pattern": "Which {entity:plural} establish a {relationship} nexus regarding {target} under {evidentiary_threshold}?",
      "required_slots": ["relationship", "entity", "target", "evidentiary_threshold"],
      "optional_slots": []
    },
    {
      "template_id": "cj_suppression_inquiry",
      "pattern": "How do {relationship} {entity:plural} affect the prosecution of {target} [at {procedural_stage}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["procedural_stage"]
    },
    {
      "template_id": "cj_proof_standard_assessment",
      "pattern": "What {relationship} {entity:plural} meet the threshold of {evidentiary_threshold} in connection with {target}?",
      "required_slots": ["relationship", "entity", "target", "evidentiary_threshold"],
      "optional_slots": []
    }
  ],
