{
  "domain": "rational_thought",
  "version": "2.0.0",
  "scope_note": "A domain ontology and taxonomy mapping formal and informal logic, epistemic justification, Bayesian inference, cognitive bias de-biasing, Toulmin argument modeling, dialectical inquiry, and critical thinking methodology.",
  "subjects": {
    "formal_and_informal_logic": {
      "description": "Deductive validity, soundness, inductive strength, formal syllogisms, and structural fallacy identification.",
      "topics": [
        "deductive_syllogistic_validity",
        "modal_and_propositional_logic",
        "informal_fallacy_detection",
        "soundness_and_completeness",
        "countermodel_generation"
      ]
    },
    "epistemology_and_justification": {
      "description": "Theories of knowledge, epistemic warrant, foundationalism vs coherentism, defeasible reasoning, and testimony evaluation.",
      "topics": [
        "epistemic_warrant_and_entitlement",
        "defeasible_reasoning_and_undercutting",
        "coherentist_web_of_belief",
        "testimony_and_epistemic_vigilance",
        "skeptical_hypothesis_evaluation"
      ]
    },
    "bayesian_and_probabilistic_inference": {
      "description": "Prior probability updates, likelihood ratios, base-rate neglect mitigation, calibration, and expected utility.",
      "topics": [
        "bayesian_prior_updating",
        "base_rate_integration",
        "likelihood_ratio_weighing",
        "epistemic_calibration_auditing",
        "doxastic_uncertainty_quantification"
      ]
    },
    "cognitive_heuristics_and_bias_mitigation": {
      "description": "System 1/System 2 dual-process dynamics, heuristics, confirmation bias de-biasing, and adversarial collaboration.",
      "topics": [
        "confirmation_bias_debiasing",
        "availability_heuristic_correction",
        "steelmanning_and_adversarial_collaboration",
        "motivated_reasoning_parsing",
        "hindsight_bias_mitigation"
      ]
    },
    "dialectics_and_argument_mapping": {
      "description": "Toulmin argumentation structures, premise-conclusion mapping, dialectical commitments, and resolution of disputed premises.",
      "topics": [
        "toulmin_warrant_and_backing",
        "dialectical_commitment_tracking",
        "premise_undercutting_and_rebuttal",
        "burden_of_inquiry_allocation",
        "semantic_ambiguity_disambiguation"
      ]
    }
  },
