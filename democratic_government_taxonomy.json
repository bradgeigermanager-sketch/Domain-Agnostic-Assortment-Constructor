{
  "domain": "democratic_government",
  "version": "2.0.0",
  "scope_note": "A domain ontology and taxonomy mapping constitutional separation of powers, legislative deliberation, executive administration, administrative rulemaking, electoral integrity, judicial check-and-balance mechanisms, and public accountability.",
  "subjects": {
    "separation_of_powers_and_checks": {
      "description": "Inter-branch balance, veto powers, legislative oversight, confirmation hearings, and constitutional prerogatives.",
      "topics": [
        "executive_veto_and_override",
        "senate_advice_and_consent",
        "congressional_investigation_and_subpoena",
        "judicial_review_of_legislation",
        "impeachment_and_removal"
      ]
    },
    "legislative_process_and_statutory_enactment": {
      "description": "Bill introduction, committee markup, floor debate, bicameral reconciliation, and statutory enrollment.",
      "topics": [
        "committee_referral_and_markup",
        "floor_amendment_and_filibuster",
        "bicameral_conference_reconciliation",
        "appropriations_and_budgetary_authorization",
        "statutory_sunset_and_reauthorization"
      ]
    },
    "executive_administration_and_rulemaking": {
      "description": "Notice-and-comment administrative rulemaking, executive orders, agency adjudication, and regulatory compliance.",
      "topics": [
        "administrative_procedure_act_rulemaking",
        "executive_order_issuance",
        "regulatory_impact_analysis",
        "agency_adjudication_and_enforcement",
        "interagency_coordination_and_clearance"
      ]
    },
    "electoral_processes_and_franchise_integrity": {
      "description": "Voter registration, ballot administration, campaign finance disclosure, certification of returns, and transition of power.",
      "topics": [
        "voter_registration_and_ballot_access",
        "campaign_finance_disclosure_auditing",
        "canvassing_and_certification_of_returns",
        "electoral_district_reapportionment",
        "peaceful_transfer_of_power"
      ]
    },
    "public_accountability_and_transparency": {
      "description": "Freedom of information requests, ethics compliance, inspectors general audits, whistleblower disclosures, and open meetings.",
      "topics": [
        "freedom_of_information_compliance",
        "inspector_general_oversight_audits",
        "government_ethics_financial_disclosure",
        "whistleblower_protection_inquiries",
        "public_notice_and_sunshine_compliance"
      ]
    }
  },
  "slots": {
    "relationship": {
      "slot_id": "relationship",
      "semantic_role": "governance_or_procedural_relation",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["relationship"],
        "domain_scope": ["democratic_government", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "entity": {
      "slot_id": "entity",
      "semantic_role": "legislative_executive_or_civic_instrument",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["entity"],
        "domain_scope": ["democratic_government", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "target": {
      "slot_id": "target",
      "semantic_role": "governance_subject_institution_or_proceeding",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["target"],
        "domain_scope": ["democratic_government", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "governance_branch": {
      "slot_id": "governance_branch",
      "semantic_role": "institutional_branch_or_forum",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["governance_branch"],
        "domain_scope": ["democratic_government", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "procedural_framework": {
      "slot_id": "procedural_framework",
      "semantic_role": "governing_rule_or_enabling_authority",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["procedural_framework"],
        "domain_scope": ["democratic_government", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    }
  },
  "templates": [
    {
      "template_id": "gov_interrogative_core",
      "pattern": "What {relationship} {entity:plural} relate to {target} [within {governance_branch}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["governance_branch"]
    },
    {
      "template_id": "gov_institutional_diagnostic",
      "pattern": "Which {entity:plural} execute a {relationship} function regarding {target} under {procedural_framework}?",
      "required_slots": ["relationship", "entity", "target", "procedural_framework"],
      "optional_slots": []
    },
    {
      "template_id": "gov_oversight_inquiry",
      "pattern": "How do {relationship} {entity:plural} originating in {governance_branch} check {target} [pursuant to {procedural_framework}]?",
      "required_slots": ["relationship", "entity", "target", "governance_branch"],
      "optional_slots": ["procedural_framework"]
    },
    {
      "template_id": "gov_accountability_evaluation",
      "pattern": "What {relationship} {entity:plural} enforce public accountability on {target} in accordance with {procedural_framework}?",
      "required_slots": ["relationship", "entity", "target", "procedural_framework"],
      "optional_slots": []
    }
  ],
