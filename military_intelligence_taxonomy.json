  "constraints": [
    {
      "type": "domain_alignment"
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "mi_rel_intercepting"
      },
      "then": {
        "slot": "entity",
        "values": [
          "mi_ent_sigint_report"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "mi_rel_mensurating"
      },
      "then": {
        "slot": "entity",
        "values": [
          "mi_ent_geoint_product",
          "mi_ent_target_folder"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "mi_rel_exploiting_source"
      },
      "then": {
        "slot": "entity",
        "values": [
          "mi_ent_humint_raw_cable"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "mi_rel_sanitizing"
      },
      "then": {
        "slot": "classification_level",
        "values": [
          "mi_cls_unclassified_fouo",
          "mi_cls_secret_rel"
        ]
      }
    },
    {
      "type": "excludes",
      "if": {
        "slot": "relationship",
        "value": "mi_rel_intercepting"
      },
      "then": {
        "slot": "target",
        "values": [
          "mi_tgt_underground_enrichment"
        ]
      }
    }
  ]
