{
  "domain": "cybersecurity",
  "version": "2.0.0",
  "scope_note": "A domain ontology and taxonomy mapping threat actors, attack vectors, defensive posture, digital forensics, incident response, and security operations center (SOC) telemetry.",
  "subjects": {
    "threat_intelligence": {
      "description": "Tactics, techniques, procedures (TTPs), threat actors, indicators of compromise, and campaign tracking.",
      "topics": [
        "actor_attribution",
        "ttp_classification",
        "ioc_extraction",
        "infrastructure_tracking",
        "threat_hunting"
      ]
    },
    "vulnerability_management": {
      "description": "Identification, assessment, remediation, and mitigation of software, firmware, and misconfiguration flaws.",
      "topics": [
        "cve_analysis",
        "surface_attack_mapping",
        "patch_management",
        "configuration_auditing",
        "exploitability_assessment"
      ]
    },
    "incident_response_and_forensics": {
      "description": "Triage, containment, host/network artifact reconstruction, chain of custody, and post-incident eradication.",
      "topics": [
        "triage_and_scoping",
        "host_artifact_analysis",
        "network_traffic_reconstruction",
        "evidence_chain_of_custody",
        "containment_and_remediation"
      ]
    },
    "security_operations": {
      "description": "Telemetry aggregation, detection engineering, SIEM/SOAR alerting, correlation, and policy enforcement.",
      "topics": [
        "detection_rule_authoring",
        "telemetry_correlation",
        "pipeline_monitoring",
        "alert_triage",
        "automated_orchestration"
      ]
    },
    "identity_and_access_control": {
      "description": "Authentication, authorization, credential governance, privileged access management, and policy boundaries.",
      "topics": [
        "credential_governance",
        "privilege_escalation_detection",
        "federation_and_sso",
        "zero_trust_enforcement",
        "mfa_bypass_analysis"
      ]
    }
  },
  "slots": {
    "relationship": {
      "slot_id": "relationship",
      "semantic_role": "predicate_relation",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["relationship"],
        "domain_scope": ["cybersecurity", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "entity": {
      "slot_id": "entity",
      "semantic_role": "focal_artifact_or_event",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["entity"],
        "domain_scope": ["cybersecurity", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "target": {
      "slot_id": "target",
      "semantic_role": "investigative_anchor",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["target"],
        "domain_scope": ["cybersecurity", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "temporal": {
      "slot_id": "temporal",
      "semantic_role": "time_qualifier",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["temporal"],
        "domain_scope": ["*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "evidence_status": {
      "slot_id": "evidence_status",
      "semantic_role": "forensic_confidence",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["evidence_status"],
        "domain_scope": ["*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    }
  },
  "templates": [
    {
      "template_id": "sec_interrogative_core",
      "pattern": "What {relationship} {entity:plural} relate to {target} [during {temporal}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["temporal", "evidence_status"]
    },
    {
      "template_id": "sec_investigative_diagnostic",
      "pattern": "Which {entity:plural} function in a {relationship} capacity regarding {target} [when {evidence_status}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["evidence_status"]
    },
    {
      "template_id": "sec_traceability_assessment",
      "pattern": "What {relationship} {entity:plural} were observed {temporal} {target}?",
      "required_slots": ["relationship", "entity", "target", "temporal"],
      "optional_slots": []
    },
    {
      "template_id": "sec_attribution_audit",
      "pattern": "How does {evidence_status} {entity:singular} exhibit a {relationship} nexus with {target}?",
      "required_slots": ["relationship", "entity", "target", "evidence_status"],
      "optional_slots": []
    }
  ],
