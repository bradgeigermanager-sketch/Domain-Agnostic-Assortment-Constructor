      },
      "then": {
        "slot": "entity",
        "values": [
          "cj_ent_miranda_waiver"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "cj_rel_charging_indicting"
      },
      "then": {
        "slot": "entity",
        "values": [
          "cj_ent_grand_jury_indictment"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "cj_rel_probation_revoking"
      },
      "then": {
        "slot": "entity",
        "values": [
          "cj_ent_parole_violation_notice"
        ]
      }
    },
    {
      "type": "excludes",
      "if": {
        "slot": "relationship",
        "value": "cj_rel_custodial_interrogating"
      },
      "then": {
        "slot": "target",
        "values": [
