      "slot_id": "epistemic_state",
      "semantic_role": "doxastic_or_justification_status",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["epistemic_state"],
        "domain_scope": ["rational_thought", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    }
  },
  "templates": [
    {
      "template_id": "rat_interrogative_core",
      "pattern": "What {relationship} {entity:plural} relate to {target} [within {inferential_framework}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["inferential_framework"]
    },
    {
      "template_id": "rat_epistemic_evaluation",
      "pattern": "Which {entity:plural} provide a {relationship} basis for {target} given {epistemic_state:article}?",
      "required_slots": ["relationship", "entity", "target", "epistemic_state"],
      "optional_slots": []
    },
    {
      "template_id": "rat_dialectical_diagnostic",
      "pattern": "How do {relationship} {entity:plural} evaluate {target} under {inferential_framework} standards?",
      "required_slots": ["relationship", "entity", "target", "inferential_framework"],
      "optional_slots": []
    },
    {
      "template_id": "rat_bias_mitigation_audit",
      "pattern": "What {relationship} {entity:plural} mitigate cognitive distortion in {target} [reaching {epistemic_state:article}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["epistemic_state"]
    }
  ],
