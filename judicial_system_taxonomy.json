{
  "domain": "judicial_system",
  "version": "2.0.0",
  "scope_note": "A domain ontology and taxonomy mapping court proceedings, pleadings, discovery, motion practice, trial events, evidentiary relations, appellate review, and record administration in the U.S. legal system.",
  "subjects": {
    "civil_procedure": {
      "description": "Rules, pleadings, motion practice, discovery procedures, and case management in civil litigation.",
      "topics": [
        "pleadings_and_service",
        "discovery_and_disclosures",
        "dispositive_motions",
        "settlement_and_adr",
        "preliminary_injunctions"
      ]
    },
    "criminal_procedure": {
      "description": "Constitutional protections, charging instruments, suppression hearings, plea bargains, and sentencing.",
      "topics": [
        "probable_cause_and_warrants",
        "arraignment_and_bail",
        "suppression_and_exclusion",
        "plea_bargaining",
        "sentencing_and_probation"
      ]
    },
    "appellate_practice": {
      "description": "Preservation of error, standards of review, briefing, oral argument, and appellate dispositions.",
      "topics": [
        "error_preservation",
        "appellate_briefing",
        "standards_of_review",
        "appellate_mandates",
        "interlocutory_appeals"
      ]
    },
    "evidence_and_record_preservation": {
      "description": "Authentication, admissibility, chain of custody, transcript verification, protective orders, and record sealing.",
      "topics": [
        "documentary_authentication",
        "witness_competency_and_impeachment",
        "privilege_and_work_product",
        "record_sealing_and_redaction",
        "spoliation_and_preservation"
      ]
    },
    "judicial_administration": {
      "description": "Docketing, calendar assignment, recusal, contempt, clerk operations, and enforcement of orders.",
      "topics": [
        "case_assignment_and_recusal",
        "scheduling_and_calendaring",
        "docket_management",
        "contempt_and_sanctions",
        "execution_and_garnishment"
      ]
    }
  },
  "slots": {
    "relationship": {
      "slot_id": "relationship",
      "semantic_role": "procedural_relation",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["relationship"],
        "domain_scope": ["judicial_system", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "entity": {
      "slot_id": "entity",
      "semantic_role": "filing_event_or_instrument",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["entity"],
        "domain_scope": ["judicial_system", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "target": {
      "slot_id": "target",
      "semantic_role": "adjudicative_anchor",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["target"],
        "domain_scope": ["judicial_system", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "case_stage": {
      "slot_id": "case_stage",
      "semantic_role": "procedural_posture",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["case_stage"],
        "domain_scope": ["judicial_system", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "participant_role": {
      "slot_id": "participant_role",
      "semantic_role": "acting_party_or_officer",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["participant_role"],
        "domain_scope": ["judicial_system", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    },
    "standard_of_review": {
      "slot_id": "standard_of_review",
      "semantic_role": "scrutiny_standard",
      "default_cardinality": "single",
      "acceptor": {
        "allowed_types": ["standard_of_review"],
        "domain_scope": ["judicial_system", "*"],
        "subject_scope": ["*"],
        "topic_scope": ["*"],
        "required_tags": [],
        "excluded_tags": []
      }
    }
  },
  "templates": [
    {
      "template_id": "jud_interrogative_core",
      "pattern": "What {relationship} {entity:plural} relate to {target} [during {case_stage}]?",
      "required_slots": ["relationship", "entity", "target"],
      "optional_slots": ["case_stage"]
    },
    {
      "template_id": "jud_role_investigation",
      "pattern": "Which {entity:plural} submitted by {participant_role:article} serve a {relationship} function regarding {target}?",
      "required_slots": ["relationship", "entity", "target", "participant_role"],
      "optional_slots": []
    },
    {
      "template_id": "jud_appellate_review",
      "pattern": "How do {relationship} {entity:plural} impact {target} under {standard_of_review} review?",
      "required_slots": ["relationship", "entity", "target", "standard_of_review"],
      "optional_slots": []
    },
    {
      "template_id": "jud_posture_diagnostic",
      "pattern": "What {relationship} {entity:plural} are authorized by {participant_role:article} in {target} [at {case_stage}]?",
      "required_slots": ["relationship", "entity", "target", "participant_role"],
      "optional_slots": ["case_stage"]
    }
  ],
