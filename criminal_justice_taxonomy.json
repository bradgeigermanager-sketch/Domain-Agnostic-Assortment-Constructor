  "constraints": [
    {
      "type": "domain_alignment"
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "cj_rel_investigative_seizing"
      },
      "then": {
        "slot": "entity",
        "values": [
          "cj_ent_search_warrant",
          "cj_ent_chain_log",
          "cj_ent_dashcam_recording"
        ]
      }
    },
    {
      "type": "requires",
