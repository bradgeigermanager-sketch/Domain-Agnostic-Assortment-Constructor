  "constraints": [
    {
      "type": "domain_alignment"
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "cr_rel_monitoring"
      },
      "then": {
        "slot": "entity",
        "values": [
          "cr_ent_consent_decree",
          "cr_ent_pattern_investigation_report"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "cr_rel_suppressing_vote"
      },
      "then": {
        "slot": "target",
        "values": [
          "cr_tgt_redistricting_plan"
        ]
      }
    },
    {
      "type": "requires",
      "if": {
        "slot": "relationship",
        "value": "cr_rel_custom_authorizing"
      },
      "then": {
        "slot": "statutory_basis",
        "values": [
          "cr_sb_section_1983",
          "cr_sb_section_14141_pattern_or_practice"
        ]
      }
    },
    {
      "type": "excludes",
      "if": {
        "slot": "relationship",
        "value": "cr_rel_remediating"
      },
      "then": {
        "slot": "entity",
        "values": [
          "cr_ent_voter_registration_purge_list",
          "cr_ent_accommodation_denial_record"
        ]
      }
    }
  ]
